<%- include('../layouts/header.ejs') %>

</head>
<body>

<%- include('../layouts/navigations') %>
<main>
    <% if(orders.length <= 0) { %>
        <h1>No Orders Yet</h1>
    <% } else { %>
        <h1>Your Orders Lists</h1>
        <% orders.forEach(order => { %>
            <ul>
                <li>
                    <h2>#<%=order._id %></h2>
                    <% order.items.forEach(item => { %>
                        <ul>
                            <li><%=item.title%> (<%=item.quantity%>)</li>
                        </ul>
                    <% }); %>
                </li>
            </ul>
        <% }); %>
    <% }; %>
</main>

</body>
</html>